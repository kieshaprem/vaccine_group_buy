             label=c(round(lower,3),round(mean(df$vals),3),round(upper,3)),
             gp=gpar(fontsize=8))
  grid.xaxis(at=c(0,20,40,60,80,100),label=c(0,2,4,6,8,10),gp=gpar(fontsize=8))
  grid.text("Iteration ('000)",y=unit(-3,"lines"),gp=gpar(fontsize=8))
  grid.text(ylabel, x=unit(-3.1,"lines"))
  popViewport()
  dev.off()
}

