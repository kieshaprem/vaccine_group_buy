for (i in (1:non_hazard_params)){
  param_name <- param_names[weeks+i]
  ylabel <- as.expression(bquote(param_name))
  df <- data.frame(index = seq(1:MCMCITS),vals = data[weeks+i])
  upper <- max(df$vals)+sd(df$vals)
  lower <- min(df$vals)-sd(df$vals)
  filename <- paste(paste("plots/", param_name, sep=""),".png",sep="")
