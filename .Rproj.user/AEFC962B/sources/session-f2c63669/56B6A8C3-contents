      res=300, pointsize=10)
  pushViewport(plotViewport(c(3,4,1,1),xscale=c(0,100),yscale=c(lower,upper)))
  grid.lines(df$index,df$vals, default.units = "native",
             gp=gpar(col="orange",lwd=1))
