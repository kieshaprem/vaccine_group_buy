library(data.table)
library(grid)

## plot 1: densities of vax dates and inf dates


raw_data <- fread("data/sim-data.csv")

filename <- "plots/final_plot_1_2.png"

tvi_density <- density(raw_data[!is.na(tvi)]$tvi)
