             label=c(0,round(upper/2,3),round(upper,3)),
             gp=gpar(fontsize=6))
  grid.xaxis(at=c(0,2000,4000,6000,8000,10000),label=c(0,2,4,6,8,10),gp=gpar(fontsize=6))
  grid.text("Iteration ('000)",y=unit(-3,"lines"),gp=gpar(fontsize=8))
