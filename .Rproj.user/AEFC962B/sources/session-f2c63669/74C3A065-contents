MCMCITS <- 1000
weeks <- 105
alpha_i <- 3
gamma_i <- 10

### get posterior means and credible interval
mean_vals <- numeric(weeks+alpha_i+gamma_i)

for (i in 1:(weeks+alpha_i+gamma_i)){
  mean_vals[i] <- mean(params_output[1:MCMCITS,i])
}
means_df <- data.frame(means = mean_vals)
row.names(means_df) <- c(paste("h",seq(1:weeks),sep=""),
                         "alpha0", "alpha1", "alpha3",
                         "gamma1", "gamma2", "gamma3",
                         "gamma4", "gamma5", "gamma6", "gamma7",
                         "gamma8", "gamma9", "gamma10")


CI <- matrix(0,ncol=2,nrow = weeks+alpha_i+gamma_i)
for (i in (1:(weeks+alpha_i+gamma_i))){
  CI[i,] <- quantile(params_output[1:MCMCITS,i],c(0.025,0.975))
}

