#burnin <- 10000
## hazard params
for (i in (1:weeks)){
  filename <- paste("plots/run21/plot_h_", i, ".png", sep="")
  par_name <- paste("h", i, sep="")
  ylabel <- as.expression((bquote(h[.(i)])))
  #data <- data.frame(index=seq((burnin+1):MCMCITS), h=params_output[(burnin+1):MCMCITS, i])
