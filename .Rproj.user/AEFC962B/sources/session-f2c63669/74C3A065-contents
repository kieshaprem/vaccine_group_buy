## joint distribution
for (i in seq(from=106, to=118)){
  for (j in seq(from=106, to=118)){
    if ((i!=109)|(j!=109)){
      filename <- paste("plots/run21/plot_joint_", i,"_",j,".png", sep="")
      png(file=filename, height = 8, width = 8, units ="cm",res=300, pointsize=10)
      data <- data.frame(x=params_output[1:MCMCITS,i], y=params_output[1:MCMCITS,j])
      lower_x <- min(data$x)
      upper_x <- max(data$x)
      lower_y <- min(data$y)
      upper_y <- max(data$y)
      if ((lower_x!=upper_x)&(lower_y!=upper_y)){
        pushViewport(plotViewport(c(3,4,1,1), xscale=c(lower_x, upper_x), yscale=c(lower_y, upper_y)))
        grid.points(data$x, data$y, default.units = "native",
                    gp=gpar(col="navy", lwd=1))
        grid.yaxis(gp=gpar(fontsize=6))
        grid.xaxis(gp=gpar(fontsize=6))
        x_label <- (names(params_output)[i])
        y_label <- (names(params_output)[j])
        grid.text(x_label, y=unit(-3, "lines"), gp=gpar(fontsize=8))
        grid.text(y_label, x=unit(-3.1,"lines"), gp=gpar(fontsize=8))
        popViewport()
        dev.off()
      }
    }
  }
}


