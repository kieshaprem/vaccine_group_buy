#vaccine-related multiplier
#getting proportion of ppl vaccinated over the days
V_prop <- numeric(days)
for (i in (1:length(data[,1]))){
  if (data[i,]$Vi==1){
    day_vac <- data[i,]$tvi
    V_prop[day_vac] <- V_prop[day_vac]+1
  }
}
V_prop <- cumsum(V_prop)
V_prop <- V_prop/length(data[,1])

#getting proportion of ppl vaccinated over the days
V_multiplier_est <- (1-V_prop)+V_prop*exp(storage_params11[366,MCMCITS])
V_multiplier_act <- (1-V_prop)+V_prop*exp(-1.1)

