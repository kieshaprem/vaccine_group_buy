source('scripts/5_table_supp_alpha_realcoverage.R')
source('scripts/5_table_supp_alpha_realcoverage.R')
source('scripts/5_table_supp_alpha_realcoverage.R')
source('scripts/2_table_supp_alpha.R')
source('scripts/6_table_supp_psa_realcoverage.R')
real_outcome_base <- run_scenario(coverage = 'real', mode = 'psa')
save(real_outcome_base,file = 'output/intermediate/psa_outcomes_real.rdata')
